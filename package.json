{
  "name": "dsh-comfyui-rp",
  "version": "0.2.5",
  "description": "ComfyRP Bridge：装在 DSH 里的本地文生图自动化桥。捕获会话正文 → 提示词会话 → 本地 ComfyUI 出图 → 图片回到右侧栏 / 悬浮球 / 图库。不依赖外部桥进程，也不调用 LLM。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools/install.mjs",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "PROMPT_FORMAT_REFERENCE.md",
    "docs/CHANGELOG.md",
    "docs/images/*.png",
    "docs/images/*.jpg",
    "docs/images/*.jpeg",
    "docs/images/*.webp",
    "docs/images/*.gif"
  ],
  "license": "MIT",
  "author": "bmhty123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmhty123/dsh-comfyui-rp.git"
  },
  "homepage": "https://github.com/bmhty123/dsh-comfyui-rp#readme",
  "bugs": {
    "url": "https://github.com/bmhty123/dsh-comfyui-rp/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "comfyui-bridge",
    "image-generation",
    "stable-diffusion",
    "txt2img",
    "automation",
    "roleplay",
    "character"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0-0",
    "node": ">=18"
  },
  "scripts": {
    "test": "node tools/test-rule.mjs && node tools/test-host.mjs && node tools/test-client.mjs",
    "test:live": "node tools/test-live.mjs",
    "comfy:dry": "node tools/comfy-smoke.mjs --dry",
    "comfy:smoke": "node tools/comfy-smoke.mjs",
    "install:profile": "node tools/install.mjs --apply",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  }
}
